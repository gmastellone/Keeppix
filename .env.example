# Only mandatory variable.
DATABASE_URL=postgres://keeppix:changeme@localhost:5432/keeppix

# Bundled Postgres (`docker compose --profile bundled`) only: the password
# baked into the container on first init. Ignored if you set your own
# DATABASE_URL against an external Postgres. `scripts/install.sh` generates
# a real one for you — never leave this as a placeholder in production.
# DB_PASSWORD=changeme

# Optional: shown with their default values.
# KEEPPIX_BIND=0.0.0.0:5673
# KEEPPIX_DATA_DIR=/data
# KEEPPIX_DB_MAX_CONNECTIONS=10
# KEEPPIX_SESSION_TTL_SECS=2592000
# KEEPPIX_LOG_FORMAT=json
# KEEPPIX_ALLOWED_ORIGINS=["https://photos.example.com"]
# RUST_LOG=info,sqlx=warn

# Bundled Postgres (`docker compose --profile bundled`): default SSD/NVMe
# profile in compose.yaml. Measure at install time; don't treat as universal.
# POSTGRES_RANDOM_PAGE_COST=1.1
# POSTGRES_SHARED_BUFFERS=2GB
# POSTGRES_EFFECTIVE_CACHE_SIZE=6GB
# POSTGRES_WORK_MEM=64MB
# POSTGRES_MAX_CONNECTIONS=20

# microSD profile (example — replace the SSD values above):
# POSTGRES_RANDOM_PAGE_COST=4.0
# POSTGRES_SHARED_BUFFERS=128MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=4GB
# POSTGRES_WORK_MEM=4MB
# POSTGRES_MAX_CONNECTIONS=100
