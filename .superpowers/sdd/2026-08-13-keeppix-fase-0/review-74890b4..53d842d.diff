+use axum::body::Body;
+use axum::http::{Request, StatusCode, header};
+use tower::ServiceExt as _;
+
+/// `/health` non tocca il database, quindi il test non ha bisogno di Postgres.
+fn app() -> axum::Router {
+    keeppix_api::router_without_state()
+}
