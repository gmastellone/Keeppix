+async fn client_routes_fall_back_to_index() {
+    if !frontend_built() {
+        eprintln!("frontend/dist assente: test saltato");
+        return;
+    }
+
+    let app = keeppix_server::embed::mount_stateless();
+    let response = app
+        .oneshot(
+            Request::builder()
+                .uri("/albums/42")
+                .body(Body::empty())
+                .unwrap(),
+        )
+        .await
+        .unwrap();
